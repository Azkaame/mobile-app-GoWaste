{
  "expo": {
    "name": "GoWaste",
    "slug": "gowaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gowaste",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ambil foto sampah untuk setoran",
        "NSPhotoLibraryUsageDescription": "Pilih foto sampah dari galeri",
        "NSLocationWhenInUseUsageDescription": "Tentukan lokasi pengambilan sampah"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#22C55E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#22C55E"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto sampah dari galeri",
          "cameraPermission": "Ambil foto sampah untuk setoran"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tentukan lokasi pengambilan sampah"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
